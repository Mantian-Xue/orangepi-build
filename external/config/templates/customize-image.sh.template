InstallAbseilCpp() {
	echo "Installing Abseil C++ library..."
	
	# Check if already installed
	if ldconfig -p | grep -q libabsl; then
		echo "Abseil C++ already installed, skipping..."
		return 0
	fi
	
	# Save current directory
	local original_dir=$(pwd)
	cd /tmp
	
	# Clone Abseil C++ repository
	git clone https://github.com/abseil/abseil-cpp.git
	cd abseil-cpp
	git checkout 215105818dfde3174fe799600bb0f3cae233d0bf # 20211102.0
	
	# Build and install
	mkdir build
	cd build
	cmake -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_POSITION_INDEPENDENT_CODE=ON \
		-DCMAKE_INSTALL_PREFIX=/usr/local/stow/absl \
		..
	ninja
	ninja install
	
	# Use stow to manage installation
	cd /usr/local/stow
	stow absl
	
	# Update library cache
	ldconfig
	
	# Clean up
	cd /tmp
	rm -rf abseil-cpp
	
	# Return to original directory
	cd "$original_dir"
	
	echo "Abseil C++ installation completed."
}

InstallCasADiCpp() {
	echo "Installing CasADi C++ library..."
	
	# Check if already installed
	if ldconfig -p | grep -q libcasadi.so; then
		echo "CasADi C++ already installed, skipping..."
		return 0
	fi
	
	# Install additional dependencies for CasADi
	DEBIAN_FRONTEND=noninteractive apt-get install -y \
		pkg-config \
		liblapack-dev \
		libopenblas-dev \
		gfortran \
		coinor-libipopt-dev
	
	# Save current directory
	local original_dir=$(pwd)
	cd /tmp
	
	# Create a directory for CasADi build
	mkdir -p casadi_build
	cd casadi_build
	
	# Clone CasADi repository
	git clone --branch 3.6.6 --depth 1 https://github.com/casadi/casadi.git
	cd casadi
	
	# Create and enter build directory
	mkdir build && cd build
	
	# Configure build options
	cmake -DWITH_PYTHON=OFF -DWITH_EXAMPLES=OFF -DWITH_IPOPT=ON ..
	
	# Build (use all available cores)
	make -j$(nproc)
	
	# Install
	make install
	
	# Update dynamic linker cache
	ldconfig
	
	# Clean up
	cd /tmp
	rm -rf casadi_build
	
	# Return to original directory
	cd "$original_dir"
	
	echo "CasADi C++ installation completed."
}

ConfigureMowerSystem() {
	echo "Configuring mower system..."
	
	# Configure ROS environment
	echo "Configuring ROS environment..."
	
	# Add ROS setup to bashrc for all users
	echo "source /opt/ros/noetic/setup.bash" >> /etc/bash.bashrc
	
	# Create mower user
	if ! id "mower" &>/dev/null; then
		useradd -m -s /bin/bash mower
		usermod -a -G sudo,dialout,gpio,spi,i2c mower
		echo "mower:mower123" | chpasswd
		
		# Add ROS environment for mower user
		echo "source /opt/ros/noetic/setup.bash" >> /home/mower/.bashrc
		echo "export ROS_WORKSPACE=/opt/mower_ws" >> /home/mower/.bashrc
		echo "if [ -f /opt/mower_ws/devel/setup.bash ]; then" >> /home/mower/.bashrc
		echo "  source /opt/mower_ws/devel/setup.bash" >> /home/mower/.bashrc
		echo "fi" >> /home/mower/.bashrc
	fi
	
	# Install Abseil C++ library
	InstallAbseilCpp
	
	# Install CasADi C++ library
	InstallCasADiCpp
	
	# Create systemd service for ROS core (optional)
	cat > /etc/systemd/system/roscore.service << EOF
[Unit]
Description=ROS Core
After=network.target

[Service]
Type=forking
User=mower
Group=mower
WorkingDirectory=/home/mower
Environment="ROS_HOME=/home/mower/.ros"
Environment="ROS_LOG_DIR=/home/mower/.ros/log"
ExecStartPre=/bin/bash -c "source /opt/ros/noetic/setup.bash"
ExecStart=/bin/bash -c "source /opt/ros/noetic/setup.bash && roscore &"
ExecStop=/usr/bin/pkill -f roscore
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
	
	# Don't enable roscore by default, let user decide
	# systemctl enable roscore
}

Main "$@"
